# gtj-scraper/backend — environment template
#
# Copy to .env and fill in. Several values are shared with gtj-backend, which
# points at the same Supabase project; copy them from that repo's env.prod
# rather than minting new ones.
#
#   cp .env.example .env
#
# .env is gitignored. Do not commit real values.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Required. src/common/config.py reads SUPABASE_URL at import time and raises
# AttributeError on startup if it is unset, so the app will not boot without it.
# Shared with gtj-backend.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# ── LLM ───────────────────────────────────────────────────────────────────────
# Provider for TrustScore explanations and the text-to-JSON extraction used by
# the scrapers. One of: openrouter | anthropic | openai (default: openrouter).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Only read when LLM_PROVIDER is switched to that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Browserbase ───────────────────────────────────────────────────────────────
# Hosted headless browser used by the UCC filing scrapers
# (src/scoring/ucc_service.py). Not used by gtj-backend, so these have no
# counterpart there — get them from browserbase.com.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8000

# ── JETNET ────────────────────────────────────────────────────────────────────
# Not yet read by this repo. Listed because TrustScore 5.0 names JETNET as the
# source for OpSpecs / fleet size, and gtj-backend already holds working
# credentials plus a client (src/jetnet/service.py, customer.jetnetconnect.com).
JETNET_USER=
JETNET_PWD=
